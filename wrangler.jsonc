{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "georoute",
  "main": ".open-next/worker.js",

  // Pin the runtime date rather than tracking latest, so a Cloudflare runtime
  // change cannot alter behaviour on a deploy that contains no code change.
  "compatibility_date": "2026-08-13",

  // Required by the adapter: Next.js and the Supabase client both reach for
  // Node built-ins (this app uses node:crypto in the share-link route), and
  // Workers only provides them behind this flag.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // The site is reachable only at its own domains. workers.dev served the
  // whole application on a hostname nobody chose, which is a second address
  // for the same content -- crawlable, outside the canonical domain, and not
  // something a visitor should ever land on.
  //
  // Both are pinned rather than left to default: leaving workers_dev unset
  // switches it on, and it was on until now precisely because it was the only
  // reachable address while the custom domains were unattached. Do not turn it
  // off again without first confirming https://www.georoutes.co.uk/ answers.
  "workers_dev": false,
  "preview_urls": false,

  // Custom domains are attached in the dashboard rather than declared here.
  // Declaring them requires a token with Zone > Workers Routes > Edit, which
  // this deploy does not have; without it `wrangler deploy` uploads the code
  // and then fails at the trigger step, leaving the two out of step. If that
  // permission is granted later, move them back here so the repository is the
  // single source of truth for where this Worker serves.

  "assets": {
    "directory": ".open-next/assets",
    // Static files are served straight from the CDN without waking the worker;
    // anything not matching an asset falls through to Next's router.
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // NEXT_PUBLIC_* values are inlined into the client bundle at build time, so
  // they must be present when the build runs, not just at request time. They
  // are not secrets -- the anon key is designed to be public and is protected
  // by row-level security.
  //
  // SUPABASE_SERVICE_ROLE_KEY is emphatically not in here. It is set with
  // `wrangler secret put`, so it never appears in the repository or in the
  // Cloudflare dashboard's plain-text variables.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.georoutes.co.uk"
  }
}
